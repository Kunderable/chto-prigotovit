# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Адрес сервера. Без своего домена подойдёт IP через точки → дефисы: 203-0-113-7.sslip.io
DOMAIN=203-0-113-7.sslip.io

# Любая длинная случайная строка; та же строка пишется в ios/Local.xcconfig как RECOGNIZE_TOKEN.
APP_TOKEN=

# Без MODEL_API_KEY сервер работает в тестовом режиме и всегда отвечает одним и тем же списком.
# Yandex AI Studio:
MODEL_BASE_URL=https://llm.api.cloud.yandex.net/v1
MODEL_API_KEY=
# gpt://<идентификатор каталога>/gemma-3-27b-it
MODEL_NAME=

# OpenRouter вместо Яндекса:
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=google/gemini-2.5-flash

# Сколько фото в час можно отправить с одного адреса.
REQUESTS_PER_HOUR=30
